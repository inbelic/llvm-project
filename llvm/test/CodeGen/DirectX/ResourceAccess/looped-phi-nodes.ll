; RUN: opt -S -dxil-resource-type -dxil-resource-access -mtriple=dxil-pc-shadermodel6.3-library %s | FileCheck %s

; Ensure that a cyclic loop of resource ptrs over different global resources is
; legalized by switching on a cyclic phi of which resource is accessed, rather
; than hanging or crashing.
;
; This might be generated by something like:
;
;   RWBuffer<float> bufA : register(u0);
;   RWBuffer<float> bufB : register(u1);
;   ...
;   for (int i = 0; i < N; ++i) {
;     dst[tid] = src[tid] * 0.5f;
;     RWBuffer<float> tmp = src; src = dst; dst = tmp;
;   }

; The selectors swap each iteration, as src and dst do. bufB is id 0 and bufA is
; id 1.
; CHECK-LABEL: define void @main(
; CHECK:      for.cond:
; CHECK-NEXT:   phi i32 [ 0, %entry ]
; CHECK-NEXT:   %[[DSTSEL:[^ ]+]] = phi i32 [ 0, %entry ], [ %[[SRCSEL:[^,]+]], %[[LATCH:[^ ]+]] ]
; CHECK-NEXT:   phi i32 [ 0, %entry ]
; CHECK-NEXT:   %[[SRCSEL]] = phi i32 [ 1, %entry ], [ %[[DSTSEL]], %[[LATCH]] ]
; CHECK-NOT:    phi target(
; CHECK:      for.body:
; CHECK-NEXT:   switch i32 %[[SRCSEL]], label %[[LOADA:.*]] [
; CHECK-NEXT:     i32 0, label %[[LOADB:.*]]
; CHECK-NEXT:   ]
; CHECK:      [[LOADB]]:
; CHECK-NEXT:   %[[HB:.*]] = tail call {{.*}} @llvm.dx.resource.handlefrombinding.tdx.TypedBuffer_f32_1_0_0t(i32 0, i32 1, i32 1, i32 %{{.*}}, ptr nonnull @.str.2)
; CHECK-NEXT:   call { float, i1 } @llvm.dx.resource.load.typedbuffer.f32.tdx.TypedBuffer_f32_1_0_0t(target("dx.TypedBuffer", float, 1, 0, 0) %[[HB]], i32 %tid)
; CHECK:      [[LOADA]]:
; CHECK-NEXT:   %[[HA:.*]] = tail call {{.*}} @llvm.dx.resource.handlefrombinding.tdx.TypedBuffer_f32_1_0_0t(i32 0, i32 0, i32 1, i32 %{{.*}}, ptr nonnull @.str)
; CHECK-NEXT:   call { float, i1 } @llvm.dx.resource.load.typedbuffer.f32.tdx.TypedBuffer_f32_1_0_0t(target("dx.TypedBuffer", float, 1, 0, 0) %[[HA]], i32 %tid)
; CHECK:        %mul = fmul float
; CHECK-NEXT:   switch i32 %[[DSTSEL]], label %[[STOREB:.*]] [
; CHECK-NEXT:     i32 1, label %[[STOREA:.*]]
; CHECK-NEXT:   ]
; CHECK:      [[STOREA]]:
; CHECK-NEXT:   %[[HA2:.*]] = tail call {{.*}} @llvm.dx.resource.handlefrombinding.tdx.TypedBuffer_f32_1_0_0t(i32 0, i32 0, i32 1, i32 %{{.*}}, ptr nonnull @.str)
; CHECK-NEXT:   call void @llvm.dx.resource.store.typedbuffer.tdx.TypedBuffer_f32_1_0_0t.f32(target("dx.TypedBuffer", float, 1, 0, 0) %[[HA2]], i32 %tid, float %mul)
; CHECK:      [[STOREB]]:
; CHECK-NEXT:   %[[HB2:.*]] = tail call {{.*}} @llvm.dx.resource.handlefrombinding.tdx.TypedBuffer_f32_1_0_0t(i32 0, i32 1, i32 1, i32 %{{.*}}, ptr nonnull @.str.2)
; CHECK-NEXT:   call void @llvm.dx.resource.store.typedbuffer.tdx.TypedBuffer_f32_1_0_0t.f32(target("dx.TypedBuffer", float, 1, 0, 0) %[[HB2]], i32 %tid, float %mul)
; CHECK:      [[LATCH]]:
; CHECK-NEXT:   %inc = add nuw i32 %i, 1

@.str = private unnamed_addr constant [5 x i8] c"bufA\00", align 1
@.str.2 = private unnamed_addr constant [5 x i8] c"bufB\00", align 1

define void @main(i32 %tid, i32 %n) {
entry:
  %0 = tail call target("dx.TypedBuffer", float, 1, 0, 0) @llvm.dx.resource.handlefrombinding.tdx.TypedBuffer_f32_1_0_0t(i32 0, i32 0, i32 1, i32 0, ptr nonnull @.str)
  %1 = tail call target("dx.TypedBuffer", float, 1, 0, 0) @llvm.dx.resource.handlefrombinding.tdx.TypedBuffer_f32_1_0_0t(i32 0, i32 1, i32 1, i32 0, ptr nonnull @.str.2)
  br label %for.cond

for.cond:
  %dst = phi target("dx.TypedBuffer", float, 1, 0, 0) [ %1, %entry ], [ %src, %for.body ]
  %src = phi target("dx.TypedBuffer", float, 1, 0, 0) [ %0, %entry ], [ %dst, %for.body ]
  %i = phi i32 [ 0, %entry ], [ %inc, %for.body ]
  %exit = icmp eq i32 %i, %n
  br i1 %exit, label %end, label %for.body

for.body:
  %srcptr = call noundef nonnull align 4 dereferenceable(4) ptr @llvm.dx.resource.getpointer.p0.tdx.TypedBuffer_f32_1_0_0t(target("dx.TypedBuffer", float, 1, 0, 0) %src, i32 %tid)
  %v = load float, ptr %srcptr, align 4
  %mul = fmul float %v, 5.000000e-01
  %dstptr = call noundef nonnull align 4 dereferenceable(4) ptr @llvm.dx.resource.getpointer.p0.tdx.TypedBuffer_f32_1_0_0t(target("dx.TypedBuffer", float, 1, 0, 0) %dst, i32 %tid)
  store float %mul, ptr %dstptr, align 4
  %inc = add nuw i32 %i, 1
  br label %for.cond

end:
  ret void
}
